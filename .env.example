# Market contract on Arc Testnet (USDC, EURC, cirBTC)
VITE_LENDING_POOL_ADDRESS=0x7123a2846d167e42489dc4496b3a3e6081117052
# EURC token on Arc Testnet
VITE_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# cirBTC token on Arc Testnet (8 decimals)
VITE_CIRBTC_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
# Privy app ID (public). Enable Google in the Privy dashboard and allow your app's origin.
VITE_PRIVY_APP_ID=cmwhmtd2o00j70hjrc0oi1c7g

# Price feeds on Arc Testnet (mirrors of the Arc mainnet Chainlink feeds, kept fresh by the relay script)
VITE_EURC_PRICE_FEED_ADDRESS=0x8e6981aa888371715e7f047ad038c734f6da1208
VITE_USDC_PRICE_FEED_ADDRESS=0x4a4aa3ec89468e043515f299f6273c38f3eb4103
VITE_BTC_PRICE_FEED_ADDRESS=0xe4666036661a2ea0c5fce63ffa19bee9e9ae7374


# AI assistant server (never prefix with VITE_). Set one of these keys, optional model override.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=
# AI_SERVER_PORT=3001
# Or any OpenAI-compatible service, including free tiers and a local Ollama (set AI_MODEL too):
# AI_BASE_URL=
# AI_API_KEY=
# Free-tier shortcut: AI_PROVIDER=groq or gemini, plus AI_API_KEY (AI_MODEL optional).
# AI_PROVIDER=

# Agent wallet (server only, never prefix with VITE_). Create the key in the Circle Console, then register an entity secret.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# Redis for the agent wallet on Vercel (added by the Upstash integration). Not needed for local development.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: URL of the Cloudflare liquidation bot (shows its status on the Analytics > Risk tab)
VITE_BOT_URL=

# PRIVATE KEYS. Leave these EMPTY in this file: it is committed to GitHub.
# Put real values only in your local .env (never prefix with VITE_) and in Cloudflare as Worker Secrets.
# Wallet that updates the price feeds (its address must be the feeds' updater). Used by `bun run relay:price` and the bot.
RELAYER_PRIVATE_KEY=
# Separate wallet the liquidation bot uses to repay debt. Testnet only.
LIQUIDATOR_PRIVATE_KEY=
