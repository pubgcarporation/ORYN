{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_LENDING_POOL_ADDRESS": "0x84b8d4ba692aa57250c0bd99d8080529fd81825e",
      "VITE_EURC_ADDRESS": "0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a",
      "VITE_CIRBTC_ADDRESS": "0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF",
      "VITE_EURC_PRICE_FEED_ADDRESS": "0xc7f9471f68b473058260ec35d11d3914e1e5316f",
      "VITE_USDC_PRICE_FEED_ADDRESS": "0x9079cfc19553b44d724c92e4aa8b9c41d2f12c6b",
      "VITE_BTC_PRICE_FEED_ADDRESS": "0x2ccf7c5c2681fee5ebc309827b9a1d481218bfd3",
      "VITE_PRIVY_APP_ID": "cmwhmtd2o00j70hjrc0oi1c7g"
    }
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
