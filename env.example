# Copy to .env. These values are public (contract and token addresses, Privy app ID). No secrets belong in this file.

# Market contract on Arc Testnet (USDC, EURC, cirBTC)
VITE_LENDING_POOL_ADDRESS=0x7123a2846d167e42489dc4496b3a3e6081117052
# EURC token on Arc Testnet
VITE_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# cirBTC token on Arc Testnet (8 decimals)
VITE_CIRBTC_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
# Privy app ID (public). Enable Google in the Privy dashboard and allow your app's origin.
VITE_PRIVY_APP_ID=cmwhmtd2o00j70hjrc0oi1c7g

# Price feeds on Arc Testnet (mirrors of the Arc mainnet Chainlink feeds, kept fresh by the relay script)
VITE_EURC_PRICE_FEED_ADDRESS=0x8e6981aa888371715e7f047ad038c734f6da1208
VITE_USDC_PRICE_FEED_ADDRESS=0x4a4aa3ec89468e043515f299f6273c38f3eb4103
VITE_BTC_PRICE_FEED_ADDRESS=0xe4666036661a2ea0c5fce63ffa19bee9e9ae7374

# Only for running `bun run relay:price` (never commit a real value, never prefix with VITE_)
# RELAYER_PRIVATE_KEY=
